PORT=5001
NODE_ENV=development
JWT_SECRET=your_jwt_secret_here

# MongoDB — paste your Atlas URI here when ready (same key for local or Atlas)
# Local:  mongodb://localhost:27017/pg_management
# Atlas:  mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/pg_management?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/pg_management?retryWrites=true&w=majority

# Master admin (seeded via `npm run seed`)
MASTER_ADMIN_EMAIL=admin@pgmanagement.local
MASTER_ADMIN_PASSWORD=Admin@12345
MASTER_ADMIN_NAME=Master Admin

# Cloudflare R2 (KYC image storage) — see R2 dashboard > Manage API Tokens
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_BUCKET_URL=

# Set to true to make owners who sign up themselves wait for a superadmin's
# approval. Off for now: every sign-up gets access straight away.
OWNER_SIGNUP_REQUIRES_APPROVAL=false

# Push notifications (Expo Push Service). Optional: only needed if you turn on
# "Enhanced push security" for the project at expo.dev > Access tokens.
EXPO_ACCESS_TOKEN=
# How often to check for new alerts to push, in minutes (pushes only go out 08:00–21:00 IST).
PUSH_SWEEP_MINUTES=30
