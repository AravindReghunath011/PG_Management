PORT=5001
NODE_ENV=development
JWT_SECRET=your_jwt_secret_here

# MongoDB — paste your Atlas URI here when ready (same key for local or Atlas)
# Local:  mongodb://localhost:27017/pg_management
# Atlas:  mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/pg_management?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/pg_management?retryWrites=true&w=majority

# Master admin (seeded via `npm run seed`)
MASTER_ADMIN_EMAIL=admin@pgmanagement.local
MASTER_ADMIN_PASSWORD=Admin@12345
MASTER_ADMIN_NAME=Master Admin

# Cloudflare R2 (KYC image storage) — see R2 dashboard > Manage API Tokens
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_BUCKET_URL=
